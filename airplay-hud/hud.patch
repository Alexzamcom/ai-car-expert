@@ -18,8 +22,18 @@ fun VideoSurfaceView(
     aspectRatio: Float = 16f / 9f,
     // false = caller sizes the surface (content-scale modes)
     applyAspectRatio: Boolean = true,
-    modifier: Modifier = Modifier
+    modifier: Modifier = Modifier,

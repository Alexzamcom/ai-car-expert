+
+// TextureView participates in the view transform on API 29. The decoded frame stays
+// on a hardware surface. Only the projected content flips, not the Android controls.
+@Composable
+private fun MirroredHudSurface(
+    onSurfaceAvailable: (Surface) -> Unit,
+    onSurfaceDestroyed: (Surface) -> Unit,
+    modifier: Modifier,
+    onHudFrame: ((Bitmap) -> Unit)?
+) {
+    val attach by rememberUpdatedState(onSurfaceAvailable)
+    val detach by rememberUpdatedState(onSurfaceDestroyed)
+    val capture by rememberUpdatedState(onHudFrame)
+    AndroidView(
+        factory = { context ->
+            TextureView(context).apply {
+                scaleX = -1f
+                surfaceTextureListener = object : TextureView.SurfaceTextureListener {
+                    private var output: Surface? = null
+                    private var lastFrame = 0L
+
+                    override fun onSurfaceTextureAvailable(texture: SurfaceTexture, width: Int, height: Int) {
+                        output = Surface(texture).also { attach(it) }
+                    }
+
+                    override fun onSurfaceTextureSizeChanged(texture: SurfaceTexture, width: Int, height: Int) = Unit
+                    override fun onSurfaceTextureUpdated(texture: SurfaceTexture) {
+                        val emit = capture ?: return
+                        val now = SystemClock.elapsedRealtime()
+                        if (now - lastFrame < 850 || width <= 0 || height <= 0) return
+                        lastFrame = now
+                        val frameHeight = (512f * height / width).roundToInt()
+                        if (frameHeight !in 1000..1200) return
+                        getBitmap(512, frameHeight)?.let(emit)
+                    }
+
+                    override fun onSurfaceTextureDestroyed(texture: SurfaceTexture): Boolean {
+                        output?.let { surface ->
+                            detach(surface)
+                            surface.release()
+                        }
+                        output = null
+                        return true
+                    }
+                }
+            }
+        },
+        modifier = modifier
+    )
+}

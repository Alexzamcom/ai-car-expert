{
  "name": "ai-car-expert",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Car Expert — автомобильный PWA-интерфейс для iPad Pro 12,9″ (вертикальная установка)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "build:android": "tsc --noEmit && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "ios:sync": "npm run build:android && cap sync ios"
  },
  "dependencies": {
    "@adret-maps/valhalla-wasm": "3.9.0-alpha.2",
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.10",
    "@capacitor/ios": "7.6.10",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
